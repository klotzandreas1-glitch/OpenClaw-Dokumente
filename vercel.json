{
  "buildCommand": "cd steuer-assistent && npm run build",
  "outputDirectory": "steuer-assistent/dist",
  "installCommand": "npm install && cd steuer-assistent && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
